{
  "name": "@lazuee/config",
  "version": "0.0.1",
  "description": "Shared TypeScript, Oxlint, and Oxfmt configs for my projects.",
  "files": [
    "dist",
    "scripts",
    "*.json"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": {
      "types": "./dist/tools/oxfmt/index.d.ts",
      "import": "./dist/tools/oxfmt/index.js",
      "default": "./dist/tools/oxfmt/index.js"
    },
    "./oxlint": {
      "types": "./dist/tools/oxlint/config/index.d.ts",
      "import": "./dist/tools/oxlint/config/index.js",
      "default": "./dist/tools/oxlint/config/index.js"
    },
    "./oxlint/rules": {
      "types": "./dist/tools/oxlint/rules/index.d.ts",
      "import": "./dist/tools/oxlint/rules/index.js",
      "default": "./dist/tools/oxlint/rules/index.js"
    },
    "./oxlint/core": {
      "types": "./dist/tools/oxlint/config/core/index.d.ts",
      "import": "./dist/tools/oxlint/config/core/index.js",
      "default": "./dist/tools/oxlint/config/core/index.js"
    },
    "./oxlint/js-plugins": {
      "types": "./dist/tools/oxlint/config/js-plugins/index.d.ts",
      "import": "./dist/tools/oxlint/config/js-plugins/index.js",
      "default": "./dist/tools/oxlint/config/js-plugins/index.js"
    },
    "./oxlint/react": {
      "types": "./dist/tools/oxlint/config/react/index.d.ts",
      "import": "./dist/tools/oxlint/config/react/index.js",
      "default": "./dist/tools/oxlint/config/react/index.js"
    },
    "./oxlint/remix": {
      "types": "./dist/tools/oxlint/config/remix/index.d.ts",
      "import": "./dist/tools/oxlint/config/remix/index.js",
      "default": "./dist/tools/oxlint/config/remix/index.js"
    },
    "./oxlint/tanstack": {
      "types": "./dist/tools/oxlint/config/tanstack/index.d.ts",
      "import": "./dist/tools/oxlint/config/tanstack/index.js",
      "default": "./dist/tools/oxlint/config/tanstack/index.js"
    },
    "./oxlint/tanstack/js-plugins": {
      "types": "./dist/tools/oxlint/config/tanstack/js-plugins/index.d.ts",
      "import": "./dist/tools/oxlint/config/tanstack/js-plugins/index.js",
      "default": "./dist/tools/oxlint/config/tanstack/js-plugins/index.js"
    },
    "./shared/ignores": {
      "types": "./dist/tools/shared/ignores.d.ts",
      "import": "./dist/tools/shared/ignores.js",
      "default": "./dist/tools/shared/ignores.js"
    },
    "./tsconfig-node": "./tsconfig.node.json",
    "./tsconfig-react": "./tsconfig.react.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepare": "bun run build",
    "lint": "oxlint --config oxlint.config.ts",
    "lint:fix": "oxlint --config oxlint.config.ts --fix",
    "lint:agent": "oxlint --config oxlint.config.ts --deny-warnings --format=agent",
    "fmt": "oxfmt --config oxfmt.config.ts",
    "fmt:check": "oxfmt --config oxfmt.config.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test .",
    "check": "bun run build && bun run lint && bun run fmt:check && bun run typecheck && bun run test",
    "postinstall": "bun run scripts/link-typescript-5.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.94.0",
    "@types/bun": "^1.4.4",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "oxlint-tailwindcss": "^1.17.2",
    "typescript": "7",
    "typescript-5": "npm:typescript@^5.9.3"
  },
  "peerDependencies": {
    "eslint-plugin-github": ">= 6",
    "eslint-plugin-sonarjs": ">= 4.2.2",
    "oxfmt": ">= 0.71.0",
    "oxlint": ">= 1.86.0",
    "oxlint-plugin-react-doctor": ">= 0.9.14",
    "oxlint-tailwindcss": ">= 1.14.0",
    "typescript": ">= 7"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-github": {
      "optional": true
    },
    "eslint-plugin-sonarjs": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-plugin-react-doctor": {
      "optional": true
    },
    "oxlint-tailwindcss": {
      "optional": true
    }
  }
}
